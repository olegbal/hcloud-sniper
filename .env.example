# Hetzner Cloud API token with Read & Write permission
HCLOUD_TOKEN=
# Slack incoming webhook (optional; log-only if empty)
SLACK_WEBHOOK=
HC_TYPE=cx33
# priority order, first available wins
HC_LOCATIONS=fsn1,nbg1,hel1
HC_NAME=cx33-node
HC_IMAGE=debian-13
# comma-separated SSH key names/ids from the Hetzner project
HC_SSH_KEYS=
# seconds between polls; the budget refills 1 req/s, so 1 is the hard floor
# and leaves no headroom. 5 is a good setting for a type that is fought over.
HC_INTERVAL=5
# slow to 30s polls once fewer than this many requests are left in the hour
HC_RESERVE=600
# seconds to sleep after a 429
HC_BACKOFF=60
