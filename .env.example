# Hetzner Cloud API token with Read & Write permission
HCLOUD_TOKEN=
# Slack incoming webhook (optional; log-only if empty)
SLACK_WEBHOOK=
HC_TYPE=cx33
# priority order, first available wins
HC_LOCATIONS=fsn1,nbg1,hel1
HC_NAME=cx33-node
HC_IMAGE=debian-13
# comma-separated SSH key names/ids from the Hetzner project
HC_SSH_KEYS=
HC_INTERVAL=45
